<Project Sdk="Microsoft.NET.Sdk.Web">

	<!-- Benchmark-only HTTP host for the wrapped-engine baseline (model binding via minimal API). Not shipped in the image.
	     Built NativeAOT on the same chiselled base as the real service for a like-for-like HTTP comparison. -->
	<PropertyGroup>
		<IsPackable>false</IsPackable>
		<PublishAot>true</PublishAot>
		<InvariantGlobalization>true</InvariantGlobalization>
		<ServerGarbageCollection>false</ServerGarbageCollection>
		<UseSystemZlib>false</UseSystemZlib>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\RuleEngine.Wrapped\RuleEngine.Wrapped.csproj" />
	</ItemGroup>

</Project>
