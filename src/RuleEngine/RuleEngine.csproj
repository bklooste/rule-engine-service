<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<AssemblyName>RuleEngine</AssemblyName>
		<RootNamespace>Templates</RootNamespace>
		<InvariantGlobalization>true</InvariantGlobalization>
		<PublishAot>true</PublishAot>
		<TrimMode>partial</TrimMode>
		<ServerGarbageCollection>false</ServerGarbageCollection>
		<UseSystemZlib>false</UseSystemZlib>
		<LangVersion>preview</LangVersion>
		<GenerateAssemblyInfo>true</GenerateAssemblyInfo>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.0" />
		<PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
		<PackageReference Include="Microsoft.Extensions.Caching.Hybrid" Version="10.1.0" />
		<PackageReference Include="StackExchange.Redis" Version="2.10.1" />
		<PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.19.0" />
		<PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.19.0" />
		<PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.19.0" />
		<PackageReference Include="OpenTelemetry.Instrumentation.StackExchangeRedis" Version="1.19.0-beta.1" />
	</ItemGroup>

</Project>
